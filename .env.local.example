# Google AI (Gemini) — get your key at aistudio.google.com
GOOGLE_AI_API_KEY=your-google-ai-key-here

# Auth — REQUIRED for user login. Any random string of 16+ characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Optional: set to "true" to close new-account registration
# SIGNUPS_DISABLED=true

# Optional local override: treat every request as a site admin (edit any song,
# reach the global tools). Do NOT set this in a real deployment — use a DB
# admin user instead (the first account to register becomes one).
# ADMIN_MODE=true
